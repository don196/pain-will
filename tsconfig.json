{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true
  },
  "include": [
    "src"
  ]
}